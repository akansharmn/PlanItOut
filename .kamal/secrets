# Option 3: Read secrets via kamal secrets helpers
# These will handle logging in and fetching the secrets in as few calls as possible
# There are adapters for 1Password, LastPass + Bitwarden
#
 SECRETS=$(kamal secrets fetch --adapter 1password --account 3MX5WS2OKNFRJOVGLM2ORCJZJU --from PlanItout/Production planitout_db planitout_password planitout_user docker_password)
 POSTGRES_DB=$(kamal secrets extract planitout_db $SECRETS)
 POSTGRES_PASSWORD=$(kamal secrets extract planitout_password $SECRETS)
 POSTGRES_USER=$(kamal secrets extract planitout_user $SECRETS)
 docker_password=$(kamal secrets extract docker_password $SECRETS)
 PGDATABASE=$(kamal secrets extract planitout_db $SECRETS)
 PGUSER=$(kamal secrets extract planitout_user $SECRETS)
 PGPASSWORD=$(kamal secrets extract docker_password $SECRETS)
