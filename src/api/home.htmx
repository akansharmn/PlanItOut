
<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <h1 class="mb-4">Welcome to PlanItOut</h1>

      <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">Quick Actions</h2>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <button hx-get="/createRecipePage" hx-target="body" class="btn btn-outline-primary w-100">
                <i class="bi bi-plus-circle me-2"></i>Add Recipe
              </button>
            </div>
            <div class="col-md-6">
              <a href="/recipes" class="btn btn-outline-primary w-100">
                <i class="bi bi-journal-text me-2"></i>View Recipes
              </a>
            </div>
            <div class="col-md-6">
              <button hx-get="/meal-planner" hx-target="#main-content" class="btn btn-outline-primary w-100">
                <i class="bi bi-calendar-week me-2"></i>Plan Meals
              </button>
            </div>
            <div class="col-md-6">
              <button hx-get="/shopping-list" hx-target="#main-content" class="btn btn-outline-primary w-100">
                <i class="bi bi-cart me-2"></i>Shopping List
              </button>
            </div>f
          </div>
        </div>
      </div>

      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">Recent Recipes</h2>
        </div>
        <div class="card-body">
          <!-- Using HTMX to load content when page loads -->
          <div class="row" 
               id="recent-recipes"
               hx-get="/recipes" 
               hx-trigger="load"
               hx-indicator=".loading-indicator">
            <div class="col-12 text-center py-3 loading-indicator">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
