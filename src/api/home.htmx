
<div class="welcome-card">
    <h1 class="page-title">Welcome to PlanItOut</h1>
    <p class="welcome-text">Plan your weekly meals for the entire family with ease</p>
    
    <div class="action-cards-container">
        <!-- Create Recipe Card -->
        <div class="action-card">
            <div class="card-media">
                <div class="card-icon">
                    <i class="material-icons">restaurant</i>
                </div>
            </div>
            <div class="card-content">
                <h2>Create Recipe</h2>
                <p>Add new recipes to your collection for meal planning.</p>
            </div>
            <div class="card-actions">
                <a href="/createRecipe" class="button">
                    Get Started
                </a>
            </div>
        </div>
        
        <!-- Plan My Week Card -->
        <div class="action-card">
            <div class="card-media" style="background-color: #018786;">
                <div class="card-icon">
                    <i class="material-icons">calendar_today</i>
                </div>
            </div>
            <div class="card-content">
                <h2>Plan My Week</h2>
                <p>Create and manage your weekly meal schedule.</p>
            </div>
            <div class="card-actions">
                <a href="/recipes" class="button">
                    Get Started
                </a>
            </div>
        </div>
    </div>
    
    <!-- Recent Recipes Section -->
    <div class="recent-recipes">
        <h2>Your Recent Recipes</h2>
        <div id="recent-recipes-container" hx-get="/recipes" hx-trigger="load" hx-target="#recent-recipes-container">
            <div class="progress-indicator">
                Loading...
            </div>
        </div>
    </div>
</div>

