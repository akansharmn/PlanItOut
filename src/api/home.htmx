<div class="container py-4">
    <div class="card shadow mb-4">
        <div class="card-body">
            <h1 class="card-title text-primary">Welcome to PlanItOut</h1>
            <p class="card-text lead mb-4">Plan your weekly meals for the entire family with ease</p>

            <div class="row mb-5">
                <!-- Create Recipe Card -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white p-3 text-center">
                            <i class="material-icons display-4">restaurant</i>
                        </div>
                        <div class="card-body">
                            <h2 class="card-title h4">Create Recipe</h2>
                            <p class="card-text">Add new recipes to your collection for meal planning.</p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="/createRecipe" class="btn btn-primary">
                                Get Started
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Plan My Week Card -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-success text-white p-3 text-center">
                            <i class="material-icons display-4">calendar_today</i>
                        </div>
                        <div class="card-body">
                            <h2 class="card-title h4">Plan My Week</h2>
                            <p class="card-text">Create and manage your weekly meal schedule.</p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="/recipes" class="btn btn-success">
                                Get Started
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Recipes Section -->
            <div class="recent-recipes">
                <h2 class="h3 mb-3 border-bottom pb-2">Your Recent Recipes</h2>
                <div id="recent-recipes-container" class="mt-3" hx-get="/recipes" hx-trigger="load" hx-target="#recent-recipes-container">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading your recipes...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>