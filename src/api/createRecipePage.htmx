<?php include 'src/templates/header.php'; ?>

<div class="container py-4">
    <div class="card shadow mb-4">
        <div class="card-body">
            <h1 class="card-title text-info mb-4">Add New Recipe</h1>

            <form id="recipe-form" hx-post="/createRecipe" hx-swap="none" hx-on::after-request="handleFormSubmit(event)">
                <div class="mb-3">
                    <label for="recipeName" class="form-label">Recipe Name</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-egg-fried"></i>
                        </span>
                        <input type="text" id="recipeName" name="recipeName" class="form-control" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="ingredients" class="form-label">Ingredients</label>
                    <textarea id="ingredients" name="ingredients" class="form-control" rows="4" required placeholder="List ingredients, one per line"></textarea>
                </div>

                <div class="mb-3">
                    <label for="prePreparations" class="form-label">Preparation Instructions</label>
                    <textarea id="prePreparations" name="prePreparations" class="form-control" rows="5" required placeholder="Describe the preparation steps"></textarea>
                </div>

                <button class="btn btn-info text-white" type="submit">
                    <i class="bi bi-plus-circle me-2"></i>
                    Add Recipe
                </button>
            </form>

            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
                <div id="resultToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header">
                        <strong class="me-auto">Recipe Status</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">
                        Recipe added successfully!
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize toast
        window.resultToast = new bootstrap.Toast(document.getElementById('resultToast'));

        window.handleFormSubmit = function(event) {
            const status = event.detail.successful;
            const xhr = event.detail.xhr;

            if (status) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    if (response.status === 'success') {
                        document.querySelector('.toast-body').textContent = 'Recipe added successfully!';
                        document.querySelector('.toast-header').classList.remove('bg-danger', 'text-white');
                        document.querySelector('.toast-header').classList.add('bg-success', 'text-white');
                        window.resultToast.show();
                        document.getElementById('recipe-form').reset();
                    } else {
                        document.querySelector('.toast-body').textContent = 'Error: ' + response.message;
                        document.querySelector('.toast-header').classList.remove('bg-success', 'text-white');
                        document.querySelector('.toast-header').classList.add('bg-danger', 'text-white');
                        window.resultToast.show();
                    }
                } catch (e) {
                    document.querySelector('.toast-body').textContent = 'Error processing response';
                    document.querySelector('.toast-header').classList.remove('bg-success', 'text-white');
                    document.querySelector('.toast-header').classList.add('bg-danger', 'text-white');
                    window.resultToast.show();
                }
            } else {
                document.querySelector('.toast-body').textContent = 'Error: Failed to submit form';
                document.querySelector('.toast-header').classList.remove('bg-success', 'text-white');
                document.querySelector('.toast-header').classList.add('bg-danger', 'text-white');
                window.resultToast.show();
            }
        };
    });
</script>

